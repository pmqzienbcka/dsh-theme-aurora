{
  "name": "dsh-theme-aurora",
  "version": "1.0.1",
  "type": "module",
  "description": "Aurora theme: background pictures, frosted glass, dimming, typography, corner radius and freely placed pictures for the DSH Web client.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "theme",
    "appearance",
    "wallpaper",
    "glass"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmqzienbcka/dsh-theme-aurora.git"
  },
  "homepage": "https://github.com/pmqzienbcka/dsh-theme-aurora#readme",
  "bugs": {
    "url": "https://github.com/pmqzienbcka/dsh-theme-aurora/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/fonts.mjs",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
